<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.sentencebuilder.ui.SentenceBuilderController">
    <top>
        <VBox spacing="6.0" style="-fx-padding: 18 20 8 20;">
            <Label text="Sentence Builder"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Choose a plain-text source file. Large files are read on a background thread so the window stays responsive."
                   wrapText="true"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12.0" style="-fx-padding: 12 20 20 20;">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="Text file:"/>
                <TextField fx:id="filePathField"
                           promptText="Choose or type a .txt file path"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="browseButton"
                        text="_Browse..."
                        mnemonicParsing="true"
                        onAction="#onBrowseFile"/>
            </HBox>

            <Label fx:id="validationLabel" wrapText="true"/>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button fx:id="importButton"
                        text="_Import"
                        mnemonicParsing="true"
                        defaultButton="true"
                        onAction="#onImportFile"/>
                <Button fx:id="cancelButton"
                        text="_Cancel"
                        mnemonicParsing="true"
                        onAction="#onCancelImport"/>
                <ProgressBar fx:id="importProgressBar"
                             progress="0.0"
                             prefWidth="300.0"/>
            </HBox>

            <Label fx:id="statusLabel" wrapText="true"/>
            <Label text="Read summary" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="summaryArea"
                      editable="false"
                      focusTraversable="false"
                      wrapText="true"
                      VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
